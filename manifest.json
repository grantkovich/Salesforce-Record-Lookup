{
  "manifest_version": 3,
  "name": "Salesforce Record Lookup",
  "description": "Open any Salesforce record from its ID, or run a global search, in any org. Nothing leaves your browser.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Salesforce Record Lookup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "sf"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the lookup popup"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
